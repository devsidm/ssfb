# Exempel för DEV. Fyll INTE i lösenord i denna fil i Git.
# Kopiera till en privat fil utanför repot, t.ex.:
# C:\Users\JOLNE\.ssf\ssf-dev-test.env
# Spara filen som UTF-8, en variabel per rad, utan citattecken runt värdena.

# WordPress-inloggning: krävs för DEV-förkontroll och verifiering efter deploy.
SSF_WP_USER=ange-wordpress-anvandare
SSF_WP_PASSWORD=ange-wordpress-losenord

# FTP: lösenordet läses ur filen; användarnamnet skickas som -FtpUser till deployskriptet.
SSF_FTP_USER=ange-ftp-anvandare
SSF_FTP_PASSWORD=ange-ftp-losenord

# Endast för särskilda direkta Graph-tester; behövs inte för vanlig DEV-deploy.
SSF_GRAPH_CLIENT_ID=
SSF_GRAPH_CLIENT_SECRET=
SSF_GRAPH_TENANT_ID=
