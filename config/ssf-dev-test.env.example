# Copy this file outside the repository before filling values.
# Preferred private locations:
# Windows: %USERPROFILE%\.ssf\ssf-dev-test.env
# Linux/macOS: $HOME/.ssf/ssf-dev-test.env

# Required for the verified WordPress curl login path.
SSF_WP_USER=ssfhosting
SSF_WP_PASSWORD=<set locally>

# Optional/future. WordPress Application Password is not verified as the harness path.
SSF_WP_APP_PASSWORD=

# Required only for deploy/FTP tasks, not for ordinary preflight.
SSF_FTP_USER=
SSF_FTP_PASSWORD=

# Required only for direct Graph tests outside WordPress runtime.
SSF_GRAPH_CLIENT_ID=
SSF_GRAPH_CLIENT_SECRET=
SSF_GRAPH_TENANT_ID=

# Optional explicit private env file path.
SSF_SECRETS_FILE=
